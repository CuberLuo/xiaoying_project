#!/bin/sh
# ----------------------------------------------------------------------------
# Maven Wrapper (简化但可用的自举版本)
# 作用：若 .mvn/wrapper/maven-wrapper.jar 不存在则下载，再启动它。
# 真正的 Maven 发行版由 maven-wrapper.jar 自动下载，无需本机预装 Maven。
# 需要 JAVA_HOME 指向可用的 JDK（如你的 JDK 21）。
# ----------------------------------------------------------------------------
set -e

DIR=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
WRAPPER_JAR="$DIR/.mvn/wrapper/maven-wrapper.jar"
WRAPPER_PROPS="$DIR/.mvn/wrapper/maven-wrapper.properties"

if [ ! -f "$WRAPPER_PROPS" ]; then
  echo "ERROR: $WRAPPER_PROPS not found" >&2
  exit 1
fi

WRAPPER_URL=$(grep '^wrapperUrl=' "$WRAPPER_PROPS" | tail -n1 | cut -d'=' -f2-)

if [ ! -f "$WRAPPER_JAR" ]; then
  echo "Downloading Maven Wrapper jar from $WRAPPER_URL"
  mkdir -p "$(dirname "$WRAPPER_JAR")"
  if command -v curl >/dev/null 2>&1; then
    curl -fsSL -o "$WRAPPER_JAR" "$WRAPPER_URL"
  elif command -v wget >/dev/null 2>&1; then
    wget -O "$WRAPPER_JAR" "$WRAPPER_URL"
  else
    echo "ERROR: neither curl nor wget available to download wrapper jar" >&2
    exit 1
  fi
fi

if [ -z "$JAVA_HOME" ]; then
  JAVA_CMD=java
else
  JAVA_CMD="$JAVA_HOME/bin/java"
fi

exec "$JAVA_CMD" -jar "$WRAPPER_JAR" "$@"
