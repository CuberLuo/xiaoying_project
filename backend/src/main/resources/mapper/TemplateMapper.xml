<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.example.materialstudio.mapper.TemplateMapper">
    <select id="findAll" resultType="Template">
        select * from template order by created_at desc
    </select>

    <select id="findCategories" resultType="string">
        select distinct category from template order by category
    </select>

    <select id="findById" resultType="Template">
        select * from template where id = #{id}
    </select>
</mapper>
